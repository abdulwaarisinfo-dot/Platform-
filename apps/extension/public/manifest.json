{
  "manifest_version": 3,
  "name": "Flintel — LinkedIn Prospect Research",
  "version": "1.0.0",
  "description": "Research LinkedIn prospects and generate personalised outreach messages for B2B sales.",

  "permissions": ["tabs", "storage", "alarms"],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Flintel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "host_permissions": [],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
